set terminal png size 1024,1024
set output "out.png"
set xrange [-0.5:0.5]
h(p, q) = p*p*0.5 - cos(2*3.14*q)
N = 20
array E[N]

do for [i=1:N] {
    stats 'traj.dat' every ::0::0 using (h(column(2*i-1), column(2*i))) nooutput
    E[i] = STATS_min
}
plot for [i=1:N] 'traj.dat' using (column(2*i-1)):(column(2*i)) with lines title sprintf("h=%.2f", E[i])
