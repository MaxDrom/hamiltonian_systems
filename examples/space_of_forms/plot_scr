set terminal png size 1920,1080
set output "plot.png"
set parametric
set urange [0:2*pi]
set vrange [-pi/2:pi/2]
set view equal xyz
set isosamples 30

set style fill transparent solid 0.1 noborder
set pm3d depthorder

set style line 1 lc rgb "blue" lw 3  
set style line 2 pt 7 ps 3.5 lc rgb "red" 

unset key

splot cos(u)*cos(v), sin(u)*cos(v), sin(v) with pm3d, \
      'out.dat' using 1:2:3 with lines ls 1, \
      "-" using 1:2:3 with points ls 2
1.0          0.0          0.0
-0.5         0.8660254    0.0
-0.5        -0.8660254    0.0
e
